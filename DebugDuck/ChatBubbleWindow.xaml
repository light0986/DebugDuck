<Window x:Class="DebugDuck.ChatBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DebugDuck"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <!-- 聊天室：透明底 -->
    <StackPanel Margin="12">

        <!-- 訊息區：最多兩則（玩家 + 鴨子） -->
        <StackPanel x:Name="Log" Margin="0,0,0,8" />

        <!-- 輸入列 -->
        <Border x:Name="InputArea" Background="#F2FFFFFF" CornerRadius="10" Padding="8,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Direction="270" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="說"
                        Click="OnSend" Width="40" Height="28" Margin="8,0,0,0"
                        Background="#CDF5CD" BorderBrush="#8BD48B" BorderThickness="1"
                        FontWeight="SemiBold" Foreground="#12521A" Cursor="Hand" />
                <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                         FontSize="13" MinHeight="28" MaxHeight="90"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Center"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="OnInputKeyDown" />
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
