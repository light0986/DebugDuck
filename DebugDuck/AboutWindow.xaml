<Window x:Class="DebugDuck.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="關於"
        Width="300" Height="180"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="OnDrag">

    <Window.Resources>
        <!-- 圓角、亮灰色的按鈕 -->
        <Style x:Key="GreyPill" TargetType="Button">
            <Setter Property="Background" Value="#E9E9E9" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DEDEDE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CFCFCF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FBFBFB" BorderBrush="#D5D5D5" BorderThickness="1" CornerRadius="6">
        <Grid Margin="16">

            <!-- 左上角：50x50 圓形頭像 -->
            <Ellipse Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="pack://application:,,,/DebugDuck;component/Assets/light0986.ico"
                                Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <!-- 中間：作者 -->
            <TextBlock Text="作者: light0986"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="#222222" />

            <!-- 中間下方：確認 -->
            <Button Content="確認" Click="OnConfirm"
                    Style="{StaticResource GreyPill}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
