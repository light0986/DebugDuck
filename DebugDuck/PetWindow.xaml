<Window x:Class="DebugDuck.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DebugDuck"
        Width="160" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuTalk" Header="跟鴨子說話" Click="OnMenuTalk" />
            <MenuItem Header="查看歷史訊息" Click="OnMenuHistory" />
            <MenuItem Header="回到畫面中央" Click="OnMenuCenter" />
            <MenuItem Header="關於" Click="OnMenuAbout" />
            <Separator />
            <MenuItem Header="結束" Click="OnMenuExit" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          MouseMove="OnMouseMove">

        <!-- 讓整個透明區域都能接到滑鼠事件 -->
        <Grid.Background>
            <SolidColorBrush Color="#01000000" />
        </Grid.Background>

        <!-- 浮動 / 點頭 / 跳躍 / 壓扁都套在這一層 -->
        <Grid x:Name="DuckHost" RenderTransformOrigin="0.5,0.72">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="HostScale" />
                    <RotateTransform x:Name="HostRot" />
                    <TranslateTransform x:Name="HostBob" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="SpriteImage"
                   Margin="6"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />
        </Grid>
    </Grid>
</Window>
